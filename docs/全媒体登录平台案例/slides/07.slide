      <Box style={{ width: 160, height: 240, background: '#F7FBF4', border: '1px solid #D9E6D0', borderRadius: 12, padding: 20, flexDirection: 'column', justifyContent: 'space-between' }}>
        <Text style={{ fontSize: 14, color: '#A9C19D' }}>05</Text>
        <Text style={{ fontSize: 20, fontWeight: 'bold', color: '#2F3A2C', lineHeight: 1.4 }}>界面<br />交互</Text>
        <Text style={{ fontSize: 14, color: '#6B7A66', lineHeight: 1.5 }}>一窗聚合入口</Text>
