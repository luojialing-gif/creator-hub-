        <Text style={{ fontSize: 14, color: '#A9C19D' }}>02</Text>
        <Text style={{ fontSize: 20, fontWeight: 'bold', color: '#2F3A2C', lineHeight: 1.4 }}>路线<br />选型</Text>
        <Text style={{ fontSize: 14, color: '#6B7A66', lineHeight: 1.5 }}>隔离方案取舍</Text>
      </Box>
      <Text style={{ fontSize: 20, color: '#A9C19D' }}>→</Text>
      <Box style={{ width: 160, height: 240, background: '#F7FBF4', border: '1px solid #D9E6D0', borderRadius: 12, padding: 20, flexDirection: 'column', justifyContent: 'space-between' }}>
        <Text style={{ fontSize: 14, color: '#A9C19D' }}>03</Text>
        <Text style={{ fontSize: 20, fontWeight: 'bold', color: '#2F3A2C', lineHeight: 1.4 }}>数据<br />层</Text>
        <Text style={{ fontSize: 14, color: '#6B7A66', lineHeight: 1.5 }}>清单 / 排序 / 导入导出</Text>
      </Box>
      <Text style={{ fontSize: 20, color: '#A9C19D' }}>→</Text>
      <Box style={{ width: 160, height: 240, background: '#5E7A56', borderRadius: 12, padding: 20, flexDirection: 'column', justifyContent: 'space-between' }}>
        <Text style={{ fontSize: 14, color: '#CFE0C3' }}>04</Text>
        <Text style={{ fontSize: 20, fontWeight: 'bold', color: '#F7FBF4', lineHeight: 1.4 }}>会话<br />守护</Text>
        <Text style={{ fontSize: 14, color: '#CFE0C3', lineHeight: 1.5 }}>加固 · 落盘 · 保活 · 巡检</Text>
      </Box>
